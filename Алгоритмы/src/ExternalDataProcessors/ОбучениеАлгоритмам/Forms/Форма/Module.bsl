// Модуль формы обработки "Обучение алгоритмам"
// Содержит список алгоритмов с описанием и примером реализации на встроенном языке 1С.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьСписокАлгоритмов();
	
	Если ТаблицаАлгоритмов.Количество() > 0 Тогда
		ОбновитьПоляАлгоритма(ТаблицаАлгоритмов.Получить(0));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ТаблицаАлгоритмов.Количество() > 0 Тогда
		Элементы.ТаблицаАлгоритмов.ТекущаяСтрока = 0;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаАлгоритмов

&НаКлиенте
Процедура ТаблицаАлгоритмовПриАктивизацииСтроки(Элемент)
	
	Если Элементы.ТаблицаАлгоритмов.ТекущиеДанные <> Неопределено Тогда
		ЗаголовокАлгоритма = Элементы.ТаблицаАлгоритмов.ТекущиеДанные.Алгоритм;
		ОписаниеАлгоритма = Элементы.ТаблицаАлгоритмов.ТекущиеДанные.Описание;
		ПримерРеализации = СформироватьРазметкуКода(Элементы.ТаблицаАлгоритмов.ТекущиеДанные.ПримерРеализации);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет таблицу алгоритмов данными встроенного набора.
// Если таблица уже заполнена, повторное заполнение не выполняется.
///
&НаСервере
Процедура ЗаполнитьСписокАлгоритмов()
	
	Если ТаблицаАлгоритмов.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	НомерАлгоритма = 0;
	Для Каждого ДанныеАлгоритма Из НаборАлгоритмов() Цикл
		НомерАлгоритма = НомерАлгоритма + 1;
		НоваяСтрока = ТаблицаАлгоритмов.Добавить();
		НоваяСтрока.Номер = НомерАлгоритма;
		НоваяСтрока.Алгоритм = ДанныеАлгоритма.Алгоритм;
		НоваяСтрока.Описание = ДанныеАлгоритма.Описание;
		НоваяСтрока.ПримерРеализации = ДанныеАлгоритма.ПримерРеализации;
	КонецЦикла;
	
КонецПроцедуры

// Обновляет реквизиты формы, отображающие выбранный алгоритм.
//
// Параметры:
//  СтрокаАлгоритма - ДанныеФормыСтруктура, Неопределено - строка таблицы алгоритмов;
//                    Неопределено очищает поля формы.
//
&НаСервере
Процедура ОбновитьПоляАлгоритма(СтрокаАлгоритма)
	
	Если СтрокаАлгоритма = Неопределено Тогда
		ЗаголовокАлгоритма = "";
		ОписаниеАлгоритма = "";
		ПримерРеализации = "";
		Возврат;
	КонецЕсли;
	
	ЗаголовокАлгоритма = СтрокаАлгоритма.Алгоритм;
	ОписаниеАлгоритма = СтрокаАлгоритма.Описание;
	ПримерРеализации = СформироватьРазметкуКода(СтрокаАлгоритма.ПримерРеализации);
	
КонецПроцедуры

// Формирует HTML-документ с подсветкой синтаксиса для примера реализации.
//
// Параметры:
//  Код - Строка - исходный текст на встроенном языке.
//
// Возвращаемое значение:
//  Строка - HTML-документ для поля HTML-документа.
//
&НаСервере
Функция СформироватьРазметкуКода(Код)
	
	Результат = Новый Массив;
	Результат.Добавить("<html><head><meta charset=""utf-8"">");
	Результат.Добавить("<style>body{margin:0;padding:4px;background:#FFFFFF;");
	Результат.Добавить("font-family:Consolas,'Courier New',monospace;font-size:10pt;}");
	Результат.Добавить("pre{margin:0;white-space:pre;}</style></head><body><pre>");
	
	КлючевыеСлова = Новый Соответствие;
	Для Каждого Слово Из СтрРазделить("Процедура КонецПроцедуры Функция КонецФункции Если Тогда Иначе " +
		"ИначеЕсли КонецЕсли Для Каждого Из По Пока Цикл КонецЦикла Возврат Прервать Продолжить " +
		"Перем Новый И Или Не Истина Ложь Неопределено Экспорт Знач Попытка Исключение " +
		"КонецПопытки ВызватьИсключение Шаг", " ", Ложь) Цикл
		КлючевыеСлова.Вставить(Слово, Истина);
	КонецЦикла;
	
	Для Каждого СтрокаКода Из СтрРазделить(Код, Символы.ПС, Ложь) Цикл
		Результат.Добавить(РазметитьСтрокуКода(СтрокаКода, КлючевыеСлова));
		Результат.Добавить(Символы.ПС);
	КонецЦикла;
	
	Результат.Добавить("</pre></body></html>");
	Возврат СтрСоединить(Результат, "");
	
КонецФункции

// Формирует HTML-разметку одной строки кода с подсветкой лексем.
//
// Параметры:
//  СтрокаКода - Строка - строка исходного кода.
//  КлючевыеСлова - Соответствие из КлючИЗначение - множество ключевых слов языка;
//                  ключ - слово, значение - Истина.
//
// Возвращаемое значение:
//  Строка - размеченная строка.
//
&НаСервере
Функция РазметитьСтрокуКода(СтрокаКода, КлючевыеСлова)
	
	Результат = "";
	Длина = СтрДлина(СтрокаКода);
	Позиция = 1;
	
	Пока Позиция <= Длина Цикл
		
		Символ = Сред(СтрокаКода, Позиция, 1);
		
		Если Символ = "/" И Позиция < Длина И Сред(СтрокаКода, Позиция + 1, 1) = "/" Тогда
			// Комментарий до конца строки
			Результат = Результат + ОбернутьHTML(Сред(СтрокаКода, Позиция), "#008000");
			Прервать;
			
		ИначеЕсли Символ = """" Тогда
			// Строковый литерал, удвоенная кавычка внутри не закрывает строку
			НачалоСтроки = Позиция;
			Позиция = Позиция + 1;
			Пока Позиция <= Длина Цикл
				Если Сред(СтрокаКода, Позиция, 1) <> """" Тогда
					Позиция = Позиция + 1;
					Продолжить;
				КонецЕсли;
				Если Позиция < Длина И Сред(СтрокаКода, Позиция + 1, 1) = """" Тогда
					Позиция = Позиция + 2;
					Продолжить;
				КонецЕсли;
				Позиция = Позиция + 1;
				Прервать;
			КонецЦикла;
			Результат = Результат + ОбернутьHTML(Сред(СтрокаКода, НачалоСтроки, Позиция - НачалоСтроки), "#A31515");
			Продолжить;
			
		ИначеЕсли Символ = "&" Тогда
			// Директива компиляции: &НаСервере, &НаКлиенте
			НачалоДирективы = Позиция;
			Позиция = Позиция + 1;
			Пока Позиция <= Длина И ЭтоБуква(Сред(СтрокаКода, Позиция, 1)) Цикл
				Позиция = Позиция + 1;
			КонецЦикла;
			Результат = Результат + ОбернутьHTML(Сред(СтрокаКода, НачалоДирективы, Позиция - НачалоДирективы), "#AF00DB");
			Продолжить;
			
		ИначеЕсли ЭтоБуква(Символ) Или Символ = "_" Тогда
			НачалоСлова = Позиция;
			Позиция = Позиция + 1;
			Пока Позиция <= Длина Цикл
				ТекущийСимвол = Сред(СтрокаКода, Позиция, 1);
				Если ЭтоБуква(ТекущийСимвол) Или ТекущийСимвол = "_" Или ЭтоЦифра(ТекущийСимвол) Тогда
					Позиция = Позиция + 1;
					Продолжить;
				КонецЕсли;
				Прервать;
			КонецЦикла;
			Слово = Сред(СтрокаКода, НачалоСлова, Позиция - НачалоСлова);
			Если КлючевыеСлова.Получить(Слово) <> Неопределено Тогда
				Результат = Результат + ОбернутьHTML(Слово, "#0000FF");
			Иначе
				Результат = Результат + ЭкранироватьHTML(Слово);
			КонецЕсли;
			Продолжить;
			
		ИначеЕсли ЭтоЦифра(Символ) Тогда
			НачалоЧисла = Позиция;
			Позиция = Позиция + 1;
			Пока Позиция <= Длина Цикл
				ТекущийСимвол = Сред(СтрокаКода, Позиция, 1);
				Если ЭтоЦифра(ТекущийСимвол) Или ТекущийСимвол = "." Тогда
					Позиция = Позиция + 1;
					Продолжить;
				КонецЕсли;
				Прервать;
			КонецЦикла;
			Результат = Результат + ОбернутьHTML(Сред(СтрокаКода, НачалоЧисла, Позиция - НачалоЧисла), "#098658");
			Продолжить;
			
		Иначе
			Результат = Результат + ЭкранироватьHTML(Символ);
			Позиция = Позиция + 1;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Оборачивает текст в HTML-элемент span с заданным цветом.
//
// Параметры:
//  Текст - Строка - текст для выделения.
//  Цвет - Строка - цвет текста в формате CSS, например "#0000FF".
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент.
//
&НаСервере
Функция ОбернутьHTML(Текст, Цвет)
	Возврат "<span style=""color:" + Цвет + """>" + ЭкранироватьHTML(Текст) + "</span>";
КонецФункции

// Экранирует служебные символы HTML.
//
// Параметры:
//  Текст - Строка - исходный текст.
//
// Возвращаемое значение:
//  Строка - текст, безопасный для вставки в HTML.
//
&НаСервере
Функция ЭкранироватьHTML(Текст)
	Результат = СтрЗаменить(Текст, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Возврат Результат;
КонецФункции

// Определяет, является ли символ буквой русского или латинского алфавита.
//
// Параметры:
//  Символ - Строка - проверяемый символ.
//
// Возвращаемое значение:
//  Булево - Истина, если символ является буквой.
//
&НаСервере
Функция ЭтоБуква(Символ)
	Код = КодСимвола(Символ);
	Возврат (Код >= 1040 И Код <= 1103)
		Или (Код >= 65 И Код <= 90)
		Или (Код >= 97 И Код <= 122)
		Или Код = 1025 Или Код = 1105;
КонецФункции

// Определяет, является ли символ десятичной цифрой.
//
// Параметры:
//  Символ - Строка - проверяемый символ.
//
// Возвращаемое значение:
//  Булево - Истина, если символ является цифрой.
//
&НаСервере
Функция ЭтоЦифра(Символ)
	Код = КодСимвола(Символ);
	Возврат Код >= 48 И Код <= 57;
КонецФункции

// Возвращает встроенный набор алгоритмов для отображения в форме.
//
// Возвращаемое значение:
//  Массив из Структура - элементы набора, ключи:
//   * Алгоритм - Строка - наименование алгоритма;
//   * Описание - Строка - описание, сложность, область применения, типичные ошибки;
//   * ПримерРеализации - Строка - пример кода на встроенном языке.
//
&НаСервере
Функция НаборАлгоритмов()
	
	Результат = Новый Массив;
	
	// 1. Линейный поиск в массиве
	Элемент = Новый Структура;
	Элемент.Вставить("Алгоритм", "Линейный поиск в массиве");
	Элемент.Вставить("Описание", "Линейный поиск - самый простой алгоритм поиска элемента в массиве. " +
		"Он последовательно перебирает элементы от первого до последнего и сравнивает каждый с искомым значением. " +
		"Сложность O(n) по времени и O(1) по памяти. " +
		"Применять, когда массив небольшой или не отсортирован. " +
		"Типичная ошибка - выход за границы массива при ручной организации цикла.");
	Элемент.Вставить("ПримерРеализации", "&НаСервере" + Символы.ПС +
		"Функция ИндексЛинейногоПоиска(МассивДанных, ИскомоеЗначение) Экспорт" + Символы.ПС +
		"	Для Индекс = 0 По МассивДанных.Количество() - 1 Цикл" + Символы.ПС +
		"		Если МассивДанных[Индекс] = ИскомоеЗначение Тогда" + Символы.ПС +
		"			Возврат Индекс;" + Символы.ПС +
		"		КонецЕсли;" + Символы.ПС +
		"	КонецЦикла;" + Символы.ПС +
		"	Возврат -1;" + Символы.ПС +
		"КонецФункции");
	Результат.Добавить(Элемент);
	
	// 2. Двоичный поиск в отсортированном массиве
	Элемент = Новый Структура;
	Элемент.Вставить("Алгоритм", "Двоичный поиск в отсортированном массиве");
	Элемент.Вставить("Описание", "Двоичный (бинарный) поиск работает только с отсортированными массивами. " +
		"На каждом шаге проверяется средний элемент: если он больше искомого, поиск продолжается в левой половине, иначе - в правой. " +
		"Сложность O(log n) по времени и O(1) по памяти. " +
		"Применять для больших отсортированных коллекций данных. " +
		"Типичная ошибка - дробный средний индекс (в 1С деление даёт число с дробной частью) и переполнение при вычислении середины.");
	Элемент.Вставить("ПримерРеализации", "&НаСервере" + Символы.ПС +
		"Функция ДвоичныйПоиск(ОтсортированныйМассив, ИскомоеЗначение) Экспорт" + Символы.ПС +
		"	НижняяГраница = 0;" + Символы.ПС +
		"	ВерхняяГраница = ОтсортированныйМассив.Количество() - 1;" + Символы.ПС +
		"	Пока НижняяГраница <= ВерхняяГраница Цикл" + Символы.ПС +
		"		СреднийИндекс = НижняяГраница + Цел((ВерхняяГраница - НижняяГраница) / 2);" + Символы.ПС +
		"		Если ОтсортированныйМассив[СреднийИндекс] = ИскомоеЗначение Тогда" + Символы.ПС +
		"			Возврат СреднийИндекс;" + Символы.ПС +
		"		ИначеЕсли ОтсортированныйМассив[СреднийИндекс] < ИскомоеЗначение Тогда" + Символы.ПС +
		"			НижняяГраница = СреднийИндекс + 1;" + Символы.ПС +
		"		Иначе" + Символы.ПС +
		"			ВерхняяГраница = СреднийИндекс - 1;" + Символы.ПС +
		"		КонецЕсли;" + Символы.ПС +
		"	КонецЦикла;" + Символы.ПС +
		"	Возврат -1;" + Символы.ПС +
		"КонецФункции");
	Результат.Добавить(Элемент);
	
	// 3. Пузырьковая сортировка
	Элемент = Новый Структура;
	Элемент.Вставить("Алгоритм", "Пузырьковая сортировка");
	Элемент.Вставить("Описание", "Пузырьковая сортировка сравнивает соседние элементы и меняет их местами, если они стоят не по порядку. " +
		"За один проход наибольший элемент «всплывает» к концу массива, поэтому после каждого прохода несортированная часть сокращается на один элемент. " +
		"Сложность O(n^2) по времени в худшем случае, O(n) в лучшем (отсортированный массив), O(1) по памяти. " +
		"Применять для небольших массивов (до ~50 элементов) или как обучающий пример. " +
		"Типичная ошибка - отсутствие флага обмена, который позволяет остановить сортировку досрочно.");
	Элемент.Вставить("ПримерРеализации", "&НаСервере" + Символы.ПС +
		"Процедура ПузырьковаяСортировка(МассивДляСортировки)" + Символы.ПС +
		"	Количество = МассивДляСортировки.Количество();" + Символы.ПС +
		"	Для Проход = 0 По Количество - 2 Цикл" + Символы.ПС +
		"		БылОбмен = Ложь;" + Символы.ПС +
		"		Для Индекс = 0 По Количество - Проход - 2 Цикл" + Символы.ПС +
		"			Если МассивДляСортировки[Индекс] > МассивДляСортировки[Индекс + 1] Тогда" + Символы.ПС +
		"				ВременноеЗначение = МассивДляСортировки[Индекс];" + Символы.ПС +
		"				МассивДляСортировки[Индекс] = МассивДляСортировки[Индекс + 1];" + Символы.ПС +
		"				МассивДляСортировки[Индекс + 1] = ВременноеЗначение;" + Символы.ПС +
		"				БылОбмен = Истина;" + Символы.ПС +
		"			КонецЕсли;" + Символы.ПС +
		"		КонецЦикла;" + Символы.ПС +
		"		Если Не БылОбмен Тогда" + Символы.ПС +
		"			Прервать;" + Символы.ПС +
		"		КонецЕсли;" + Символы.ПС +
		"	КонецЦикла;" + Символы.ПС +
		"КонецПроцедуры");
	Результат.Добавить(Элемент);
	
	// 4. Сортировка вставками
	Элемент = Новый Структура;
	Элемент.Вставить("Алгоритм", "Сортировка вставками");
